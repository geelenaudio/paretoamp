#
# Baseline ESP-IDF configuration for Amped-ESP32 (ESP32-WROVER with PSRAM)
#

# Console/logging: compile in DEBUG (for tag-level filtering), default runtime INFO (less UART spam).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL=4

# CPU frequency (audio + BT + WiFi coexist is happier at 240MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set

# C++ exceptions are disabled: no in-tree component depends on them.
# CONFIG_COMPILER_CXX_EXCEPTIONS is not set

# Flash (WROVER-N8R8 = 8MB; partition table needs this or gen_esp32part fails at 2MB default)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Allocator notes — DO NOT CHANGE WITHOUT TESTING ALL THREE PATHS:
#   1. `CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y` was tried twice and
#      reverted. Kconfig forces STATIC TX buffers as a side-effect when
#      that option is enabled (preallocates 16 × ~1.5 KiB upfront and
#      keeps the handle table in internal DRAM), which drops the
#      pre-Bluedroid heap from 38 KiB → 21 KiB and triggers
#      `BTU_StartUp Unable to allocate resources for bt_workqueue`. The
#      defaults file can't override the Kconfig dep; would need a
#      Kconfig.projbuild patch or an IDF-version bump.
#   2. `CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096` was tried and reverted.
#      Lowering the threshold pushed BT host's small allocations
#      (FreeRTOS queue/semaphore storage) into PSRAM, which BT-controller
#      ISRs can't reach — produced `xQueueSemaphoreTake (pxQueue == NULL)`
#      and `future_await (future != NULL)` panics during BT init.
#   The 32 KiB defaults are the only stable combination on this build.
#   To free runtime DRAM, prefer task-stack moves to PSRAM with
#   `xTaskCreatePinnedToCoreWithCaps(..., MALLOC_CAP_SPIRAM)` — see the
#   `voice` and `state-bc` tasks for the pattern.

# Allow FreeRTOS task stacks to be allocated in PSRAM. Kept after removing cspot
# because WiFi + BT + Snapclient coexist still fragments internal RAM quickly, and
# this gives us headroom to move large task stacks out of DRAM if needed later.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# mbedTLS memory + bundle sizing
# Move mbedTLS buffers to PSRAM to keep internal RAM free for WiFi/BT/audio paths.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set
# CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC is not set
# CONFIG_MBEDTLS_IRAM_8BIT_MEM_ALLOC is not set

# Allocate TX/RX buffers on demand to reduce peak heap.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Certificate bundle: "common" saves a lot of RAM/flash while still covering almost all sites.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_MAX_CERTS=120

# Partition table (custom)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_idf.csv"

# WiFi + BT (enabled; detailed tuning comes later)
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y

# Controller mode: A2DP requires BR/EDR (Classic BT). Some defaults end up BLE-only.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n

# We are a *single-phone A2DP sink*. We do NOT use BLE, GATT, SMP, RFCOMM,
# HFP, or HID. Bluedroid's defaults preallocate state for all of these,
# burning ~30 KiB of internal DRAM permanently — which on this board
# (ESP32-WROVER, ~190 KiB internal heap after .bss) is the difference
# between "phone connects + WiFi + httpd all coexist" and "phone connects,
# heap drops to 700 B free, lwip_send returns ENOBUFS, and the SPA can't
# load." Strip everything we don't need:
#   - BLE off entirely → frees the host-side BLE/GATT/SMP envs
#   - ACL connections capped at 1 (single phone) instead of 4 (host) / 2
#     (controller); each unused ACL slot reserves ~2-4 KiB for HCI
#     buffers + link policy state.
#   - SMP bonds capped at 2 (current phone + spare) instead of 15.
# Saved DRAM at the A2DP_CONNECTED moment (measured): ~700 B → ~24 KiB
# free, which is enough headroom for parallel httpd workers + WiFi RX
# malloc to keep the SPA reachable while music is playing.
# CONFIG_BT_BLE_ENABLED is not set
# CONFIG_BT_GATTS_ENABLE is not set
# CONFIG_BT_GATTC_ENABLE is not set
# CONFIG_BT_SMP_ENABLE is not set
CONFIG_BT_ACL_CONNECTIONS=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_SMP_MAX_BONDS=2

# AVRCP and OBEX off too. The application code already detects this and
# logs `A2DP Enable without AVRC`. AVRCP cover-art client (`CT_COVER_ART`)
# allocates ~6 KiB for AVDTP + image-receive scratch state; OBEX/GOEP
# preallocates per-session buffers. Neither is exercised by an A2DP-sink
# music player.
# CONFIG_BT_AVRCP_ENABLED is not set
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
# CONFIG_BT_GOEPC_ENABLED is not set

# Reduce audio jitter/drift: disable WiFi modem sleep / station disconnect PM.
# (Audio streaming is sensitive to scheduling jitter; Arduino default behavior is closer to "always on".)
# Note: some options are version/target-specific; unused keys are ignored by Kconfig.
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set

# Watchdogs
# Audio workloads + WiFi/BT coexist can legitimately starve the idle task on CPU1
# for >5s during bring-up. Keep task WDT enabled, but don't require IDLE1 to run.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# Some build systems still reference the legacy alias symbols.
CONFIG_TASK_WDT_TIMEOUT_S=15
CONFIG_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
# CONFIG_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# LwIP TCP receive window — 8 KiB is a deliberate trade.
#
# History: this was 32 KiB, originally sized for Snapcast (~176 kB/s
# stereo S16 @ 44.1 kHz → 32 KiB = ~186 ms) so a long Wi-Fi hiccup
# couldn't close the window on the audio stream.
#
# But in **Bluetooth mode** the only sockets in play are the SPA's HTTP
# requests, and the browser opens up to 6 parallel connections per host.
# A 32 KiB advertised window encourages each socket to flood up to 32 KiB
# in flight → 6 × 32 = 192 KiB of pbuf-eligible traffic queued on the
# lwip TCPIP task (Core 0), the same core that runs the BT controller.
# Measured symptom: opening the EQ page consistently triggered
# `BT_APPL: Pkt dropped` storms + audio underruns, every time, regardless
# of subscriber count or JSON heap location. Confirmed by the A2DP_CONNECTED
# heap log showing only ~20 KiB internal DRAM free at runtime — the
# browser burst tipped lwip+BT into starvation.
#
# 8 KiB still gives Snapcast ~46 ms of buffered audio; the AudioEngine's
# 88 200-frame (1 s) ring buffer absorbs hiccups longer than that, so a
# Wi-Fi retransmit no longer drains the I2S DMA. ESP32-only LAN
# transfers stay >5 Mbit/s observed at 8 KiB window.
CONFIG_LWIP_TCP_WND_DEFAULT=8192
# RX mailbox needs to hold WND/MSS pbufs (≈ 6 here); 8 is a safe minimum.
# Was 64 to match the old 32 KiB window — unnecessary now and each
# entry sits in internal DRAM.
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
# Keep TCP_MSS at the wire default (1440 at 1500-byte MTU) so we don't
# re-fragment; no override here.

# LwIP socket budget. The HTTP server reserves 3 sockets for internal use
# and caps `max_open_sockets` at LWIP_MAX_SOCKETS - 3. With the default
# of 10 that's 7, which is too tight once the SPA opens its long-lived
# SSE logs connection + the browser's 6 parallel asset fetches. Bumping
# to 16 (the LwIP max) gives httpd a cap of 13 — plenty of headroom for
# concurrent page loads without starving HTTP when the SSE is attached.
CONFIG_LWIP_MAX_SOCKETS=16

# Task stats for GET /api/system/tasks (Phase 7). Trace facility is required
# by uxTaskGetSystemState; run-time stats use the ESP timer so we can report
# per-task CPU tenancy without a busy-loop sampling hook.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Pin lwip TCPIP on Core 0 next to Wi-Fi/BT so Core 1 stays available for
# audio + httpd. Documented in docs/architecture.md.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Louder `app_main` expands HW PEQ (two 30-stage lists) then sweeps peak
# gain and talks I2C. IDF's 3584-byte main stack overflowed there; Louder
# sdkconfig files set CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192. Amped stays
# on the default.

# mDNS responder: one _http._tcp service, STA only, PSRAM task/heap so we
# do not steal internal DRAM from A2DP + httpd. See docs/identity.md.
CONFIG_MDNS_MAX_SERVICES=2
# CONFIG_MDNS_PREDEF_NETIF_ETH is not set
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
# CONFIG_MDNS_TASK_CREATE_FROM_INTERNAL is not set
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# CONFIG_MDNS_MEMORY_ALLOC_INTERNAL is not set


